{
  "name": "anywidget-vector",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "description": "Front end of the anywidget-vector widget, in TypeScript (bundled with esbuild; type-checked with tsc)",
  "scripts": {
    "build": "node scripts/build-esm.mjs",
    "check": "node scripts/build-esm.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/js/*.test.ts"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
